# A.PICK Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env or secrets to version control.

# --- Database ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/postgres

# --- Supabase ---
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=YOUR_SERVER_SECRET_KEY

# --- Legacy Key Compatibility (Optional) ---
# SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_KEY
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_SECRET_KEY

# --- Server ---
PORT=3001
NODE_ENV=development

# --- Betman ---
BETMAN_BASE_URL=https://www.betman.co.kr
BETMAN_POLL_INTERVAL_OPEN_MS=300000
BETMAN_POLL_INTERVAL_NEAR_START_MS=60000
BETMAN_POLL_INTERVAL_CLOSED_MS=0
